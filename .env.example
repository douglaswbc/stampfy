# ============================================================================
# Identidade e URL pública
# ============================================================================
# URL canônica da aplicação (sem barra final). Ex.: https://app.suaempresa.com.br
VITE_APP_URL=https://your-app-url.com

# Nome exibido em título, Open Graph, JSON-LD e rodapés.
VITE_APP_NAME=Stampfy

# Descrição usada em SEO / Open Graph / Twitter Card.
# Padrão: "Crie campanhas de fidelidade com cartões digitais e recompensas..."
# VITE_APP_DESCRIPTION=

# Imagem de compartilhamento social (Open Graph). Padrão: <VITE_APP_URL>/social-preview-v2.jpg
# VITE_SOCIAL_IMAGE=

# E-mail de suporte exibido em rodapés, termos e política de privacidade.
VITE_SUPPORT_EMAIL=support@example.com

# E-mail comercial exibido em telas de upgrade e no rodapé público.
VITE_SALES_EMAIL=contato@example.com

# Telefone comercial (código do país + DDD + número, apenas dígitos).
# Exibido como link de WhatsApp na landing page. Omitir para não exibir.
# VITE_NUMBER_COMERCIAL=5511999999999

# ============================================================================
# Supabase (obrigatório)
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================================
# Funções server-side (Vercel Functions — NUNCA prefixar com VITE_)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Origem pública canônica usada por callbacks e URLs de site público.
# Normalmente igual a VITE_APP_URL.
APP_ORIGIN=https://your-app-url.com

# ============================================================================
# Domínio próprio via API da Vercel (opcional)
# ============================================================================
# O token precisa de permissão para gerenciar domínios deste projeto Vercel.
VERCEL_ACCESS_TOKEN=your-vercel-access-token
VERCEL_PROJECT_ID=your-vercel-project-id
# Opcional quando o projeto pertence a um time na Vercel.
# VERCEL_TEAM_ID=your-vercel-team-id

# ============================================================================
# Integração Zernio / WhatsApp (opcional, server-only)
# ============================================================================
# Use um valor aleatório estável com pelo menos 32 caracteres.
# Alterá-lo exige recriptografar as chaves já armazenadas.
ZERNIO_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Enviado pelos Cron Jobs da Vercel como header Authorization;
# defina com o mesmo valor de COMMUNICATIONS_CRON_SECRET.
CRON_SECRET=replace-with-a-same-secret-as-COMMUNICATIONS_CRON_SECRET
# Autoriza /api/zernio-worker; use ao menos 16 caracteres aleatórios.
COMMUNICATIONS_CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters

# ============================================================================
# Web Push (opcional, server-only para a chave privada)
# ============================================================================
# Gere um par de chaves com: node scripts/generate-vapid-keys.mjs
# VITE_WEB_PUSH_PUBLIC_KEY é pública e vai para o bundle do navegador.
VITE_WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key
# NUNCA exponha a chave privada com prefixo VITE_.
WEB_PUSH_PRIVATE_KEY=replace-with-vapid-private-key
# Deve ser uma URI mailto: ou https:. Ex.: mailto:voce@suaempresa.com.br
WEB_PUSH_SUBJECT=mailto:admin@localhost
# Autoriza /api/customer-push-worker; na Vercel pode reutilizar CRON_SECRET.
PUSH_CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters

# ============================================================================
# Opcionais — build e desenvolvimento
# ============================================================================
# Sobrescreve a origem usada por scripts/generate-sitemap.mjs
# SITE_ORIGIN=https://your-app-url.com

# Workspace de demonstração. Use SOMENTE em desenvolvimento: credenciais conhecidas.
# VITE_ENABLE_DEMO_WORKSPACE=true
# E-mail da conta demo (padrão: demo@stampfy.local, conforme supabase/seed.sql)
# VITE_DEMO_EMAIL=demo@stampfy.local

# Plataforma de demonstração (apenas dev) — ver supabase/seed.sql
# VITE_PLATFORM_DEMO_EMAIL=platform@stampfy.local